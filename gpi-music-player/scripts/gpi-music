#!/usr/bin/env bash
# Lanzador de gpi-music.
#
#   gpi-music            -> abre el reproductor
#   gpi-music --scan     -> lista la biblioteca y sale
#   gpi-music --preview salida.png -> guarda una captura de la interfaz

set -euo pipefail

INSTALL_DIR="${GPI_MUSIC_DIR:-/opt/gpi-music}"
PYTHON_BIN="${PYTHON_BIN:-/usr/bin/python3}"

if [ ! -d "$INSTALL_DIR" ]; then
    echo "gpi-music: no encontrado en $INSTALL_DIR" >&2
    exit 1
fi

export PYTHONPATH="$INSTALL_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONUNBUFFERED=1
# Si el reproductor se lanza desde EmulationStation no debe abrir una consola.
export SDL_VIDEODRIVER="${SDL_VIDEODRIVER:-}"

exec "$PYTHON_BIN" -m gpi_music "$@"
